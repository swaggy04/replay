generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id        String        @id @default(cuid())
  name      String
  createdAt DateTime      @default(now())

  requests  RequestLog[]
  apiKeys   ApiKey[]
}

model ApiKey {
  id        String    @id @default(cuid())
  key       String    @unique
  createdAt DateTime  @default(now())

  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
}

model RequestLog {
  id           String             @id @default(cuid())
  method       String
  path         String
  body         Json?
  headers      Json?
  query        Json?
  responseBody Json?
  statusCode   Int?
  durationMs   Int?
  createdAt    DateTime           @default(now())

  projectId    String?
  project      Project?          @relation(fields: [projectId], references: [id])

  replays      ReplayExecution[]
}

model ReplayExecution {
  id           String      @id @default(cuid())
  requestLogId String
  statusCode   Int?
  responseBody Json?
  durationMs   Int?
  createdAt    DateTime    @default(now())

  requestLog   RequestLog @relation(fields: [requestLogId], references: [id])
}