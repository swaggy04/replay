
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model RequestLog {
  id        String   @id @default(cuid())
  method    String
  path      String
  body      Json?
  headers Json?
  query   Json?
  responseBody Json?
  statusCode Int?
  durationMs Int?
  createdAt DateTime @default(now())
}