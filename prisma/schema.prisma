
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String     @id @default(cuid())
  clerkUserId String     @unique
  createdAt   DateTime   @default(now())

  projects    Project[]
}


model Project {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  // Replay configuration
  replayBaseUrl String? @db.VarChar(2048)

  // Temporarily nullable for safe migration
  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  requests  RequestLog[]
  apiKeys   ApiKey[]
}


model ApiKey {
  id        String     @id @default(cuid())

  key       String     @unique

  keyPrefix String

  createdAt DateTime   @default(now())
  revokedAt DateTime?

  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model RequestLog {
  id           String             @id @default(cuid())
  eventId      String?
  method       String
  path         String
  body         Json?
  headers      Json?
  query        Json?
  responseBody Json?
  statusCode   Int?
  durationMs   Int?
  createdAt    DateTime           @default(now())

  projectId    String?
  project      Project?          @relation(fields: [projectId], references: [id])

  replays      ReplayExecution[]

  @@unique([projectId, eventId])
}

model ReplayExecution {
  id           String      @id @default(cuid())
  requestLogId String
  statusCode   Int?
  responseBody Json?
  durationMs   Int?
  createdAt    DateTime    @default(now())

  requestLog   RequestLog @relation(fields: [requestLogId], references: [id])
}
